---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { Badge } from "@/components/ui/badge";
import { getCollection } from "astro:content";
import {
  getCollectionStaticPaths,
  getCollectionPage,
  getEditUrl,
  getLastUpdated,
  getTOC,
} from "@cloudflare/nimbus-docs/runtime";
import { components } from "../../components";

export const prerender = true;
export const getStaticPaths = getCollectionStaticPaths("blog");

const page = await getCollectionPage<"blog">(Astro);
if (page instanceof Response) return page;
const { entry, Content, headings, markdownUrl, ogImageUrl } = page;

// Chronological navigation across published posts, latest first. "prev" is
// the newer post, matching how a blog reads top to bottom.
const posts = (
  await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const index = posts.findIndex((p) => p.id === entry.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 ? posts[index + 1] : undefined;
const prevNext = {
  prev: newer && { label: newer.data.title, href: `/blog/${newer.id}/` },
  next: older && { label: older.data.title, href: `/blog/${older.id}/` },
};

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Blog", href: "/blog/" },
  { label: entry.data.title },
];

const toc = getTOC(headings);
const editUrl = await getEditUrl(entry);
const lastUpdated = entry.data.lastUpdated ?? (await getLastUpdated(entry));
const published = new Intl.DateTimeFormat("en", { dateStyle: "long" }).format(
  entry.data.date,
);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={false}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  mode={entry.data.mode}
  banner={entry.data.banner}
  head={entry.data.head}
  searchable={entry.data.searchable}
  noindex={entry.data.noindex}
  markdownUrl={markdownUrl}
  socialImage={entry.data.socialImage ?? ogImageUrl}
  lastUpdated={lastUpdated}
  editUrl={editUrl}
  draft={entry.data.draft}
  audience={entry.data.audience}
  collection={entry.collection}
  entryId={entry.id}
>
  <Fragment slot="page-title">
    <div class="flex items-center gap-3 flex-wrap mt-6">
      <h1 class="text-foreground mb-0 leading-tight [text-wrap:balance]" style={`font-size:var(--nb-h1-size);font-weight:var(--nb-h1-weight);letter-spacing:var(--nb-h1-tracking);font-family:var(--nb-font-display)`}>{entry.data.title}</h1>
      {entry.data.draft && <Badge text="Draft" variant="warning" size="medium" />}
    </div>
    {entry.data.description && (
      <p class="text-[0.9375rem] sm:text-[1.0625rem] text-muted-foreground leading-relaxed mt-2 mb-2 [text-wrap:pretty]">{entry.data.description}</p>
    )}
    <div class="mt-3 mb-6 flex items-center gap-3 flex-wrap text-sm text-muted-foreground">
      <time datetime={entry.data.date.toISOString()}>{published}</time>
      {entry.data.tags?.map((tag) => (
        <Badge text={tag} variant="note" size="small" />
      ))}
    </div>
  </Fragment>
  <Content components={components} />
</DocsLayout>
