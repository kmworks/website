---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Badge } from "@/components/ui/badge";
import { getCollection } from "astro:content";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

export const prerender = true;

const posts = (
  await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const dateFormat = new Intl.DateTimeFormat("en", { dateStyle: "long" });
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Blog — kmworks"
  description="Release announcements, feature deep-dives, and tutorials from the kmworks ecosystem."
  head={[
    {
      tag: "link",
      attrs: {
        rel: "alternate",
        type: "application/rss+xml",
        title: "kmworks Blog",
        href: withBase("/blog/rss.xml", base),
      },
    },
  ]}
>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1">
      <div class="mx-auto w-full max-w-3xl px-4 lg:px-6 py-14">
        <h1 class="text-foreground mb-2 leading-tight" style="font-size:var(--nb-h1-size);font-weight:var(--nb-h1-weight);letter-spacing:var(--nb-h1-tracking);font-family:var(--nb-font-display)">Blog</h1>
        <p class="text-muted-foreground mb-10">
          Release announcements, feature deep-dives, and tutorials.
          <a href={withBase("/blog/rss.xml", base)} class="text-primary hover:underline ml-2">RSS</a>
        </p>
        <ul class="flex flex-col gap-8 list-none p-0 m-0">
          {posts.map((post) => (
            <li>
              <a
                href={withBase(`/blog/${post.id}/`, base)}
                class="group block no-underline rounded-lg border border-border bg-card p-5 transition-colors hover:border-primary/50"
              >
                <time
                  datetime={post.data.date.toISOString()}
                  class="text-xs text-muted-foreground font-mono"
                >
                  {dateFormat.format(post.data.date)}
                </time>
                <h2 class="text-foreground text-xl font-semibold mt-1.5 mb-1.5 group-hover:text-primary transition-colors [text-wrap:balance]">
                  {post.data.title}
                </h2>
                {post.data.description && (
                  <p class="text-muted-foreground text-[0.9375rem] leading-relaxed m-0 [text-wrap:pretty]">
                    {post.data.description}
                  </p>
                )}
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex items-center gap-2 flex-wrap mt-3">
                    {post.data.tags.map((tag) => (
                      <Badge text={tag} variant="note" size="small" />
                    ))}
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
