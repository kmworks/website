---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import "../styles/landing.css";

export const prerender = true;

const appStoreUrl = "https://apps.apple.com/app/id6755198424";

// Capabilities of the current KMReader release. "Web UI" is the komga/kmweb
// browser interface; "Generic OPDS client" is intentionally a range, since
// OPDS readers differ.
const rows: { cap: string; kmreader: string; webui: string; opds: string }[] = [
  { cap: "Nothing to install", kmreader: "App Store", webui: "yes", opds: "Varies" },
  { cap: "Windows, Linux, Android", kmreader: "No", webui: "yes", opds: "Varies" },
  { cap: "Native iPhone and iPad app", kmreader: "yes", webui: "Browser", opds: "Varies" },
  { cap: "Native Mac app", kmreader: "yes", webui: "Browser", opds: "Varies" },
  { cap: "Apple TV", kmreader: "yes", webui: "No", opds: "Varies" },
  { cap: "Comics and manga", kmreader: "yes", webui: "yes", opds: "Varies" },
  { cap: "EPUB", kmreader: "yes", webui: "yes", opds: "Varies" },
  { cap: "PDF", kmreader: "yes", webui: "yes", opds: "Varies" },
  { cap: "Offline downloads", kmreader: "yes", webui: "No", opds: "Varies" },
  { cap: "Multiple servers", kmreader: "yes", webui: "No", opds: "Varies" },
  { cap: "Full server administration", kmreader: "Partial", webui: "yes", opds: "No" },
  { cap: "Widgets and Spotlight", kmreader: "yes", webui: "No", opds: "No" },
];
---

<BaseLayout
  title="Compare"
  description="A neutral capability comparison: KMReader, the browser Web UI, and generic OPDS clients, feature by feature."
>
  <div class="flex flex-col min-h-screen km-landing">
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1">
      <section class="section">
        <div class="container">
          <div class="sectionHead">
            <h1 class="sectionTitle">Compare</h1>
            <p class="sectionSub">
              A neutral look at what each way of reading can do. No rankings:
              the right client is the one that fits how you read.
            </p>
          </div>
          <div class="tableWrap">
            <table class="compare">
              <thead>
                <tr>
                  <th scope="col">Capability</th>
                  <th scope="col">KMReader</th>
                  <th scope="col">Web UI</th>
                  <th scope="col">OPDS app</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((r) => (
                  <tr>
                    <th scope="row">{r.cap}</th>
                    {[r.kmreader, r.webui, r.opds].map((v) => (
                      <td>
                        {v === "yes" ? (
                          <span class="yes" aria-label="Yes">✓</span>
                        ) : (
                          <span class="no">{v}</span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="techNote">
            Capabilities of the current KMReader release. "OPDS app" means any
            generic OPDS reader; they differ widely, so check yours for
            specifics. The Web UI column describes the embedded kmweb interface
            and the Komga web UI, which share the same browser constraints.
          </p>
          <div class="ctaRow" style="margin-top: 2.4rem;">
            <a class="btnPrimary" href={appStoreUrl} target="_blank" rel="noopener">
              <Icon name="ph:app-store-logo" class="w-[17px] h-[17px]" /> Get KMReader
            </a>
            <a class="btnGhost" href="/reader/">
              KMReader details <Icon name="ph:arrow-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  .km-landing .techNote {
    margin: 1.6rem 0 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--km-text-muted);
    max-width: 44rem;
  }
</style>
