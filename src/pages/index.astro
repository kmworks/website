---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { config } from "virtual:nimbus/config";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

export const prerender = true;
---

<BaseLayout
  title={config.title}
  description="kmworks is an open-source comic and manga reading ecosystem: server and native clients, drop-in compatible with Komga."
>
  <div class="flex flex-col min-h-screen page">
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1">
      <header class="hero">
        <img class="glyph" src={withBase("/img/logo.svg", import.meta.env.BASE_URL)} alt="kmworks logo" />
        <p class="eyebrow">Komga-compatible, end to end</p>
        <h1 class="title">kmworks</h1>
        <p class="sub">
          An open-source comic and manga reading ecosystem: server and native
          clients.
        </p>
      </header>

      <div class="projects">
        <a class="card" href="/server/">
          <h2 class="cardTitle">server</h2>
          <p class="desc">
            Your comics, one static binary, web UI included. Drop-in
            compatible with Komga: same API, same database.
          </p>
          <span class="link">Docs &amp; downloads <i>→</i></span>
        </a>
        <a class="card" href="/reader/">
          <h2 class="cardTitle">reader</h2>
          <p class="desc">
            Native reading on iPhone, iPad, Mac, and Apple TV, online or
            offline.
          </p>
          <span class="link">Docs &amp; App Store <i>→</i></span>
        </a>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  .page {
    background: var(--km-bg);
    color: var(--km-text);
  }

  .hero {
    text-align: center;
    padding: clamp(3rem, 9vh, 6rem) 1.5rem 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    background:
      radial-gradient(52rem 30rem at 78% 12%, var(--km-glow-a), transparent 62%),
      radial-gradient(38rem 26rem at 12% 88%, var(--km-glow-r), transparent 60%);
  }

  .glyph {
    width: 96px;
    height: 96px;
    margin-bottom: 1.6rem;
  }

  .eyebrow {
    font-family: var(--nb-font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--km-accent);
    margin: 0 0 1.1rem;
  }

  .title {
    font-family: var(--nb-font-display);
    font-size: clamp(2.8rem, 7vw, 4.6rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0 0 1.1rem;
    background: linear-gradient(155deg, var(--km-grad-a) 30%, var(--km-grad-b) 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .sub {
    max-width: 32rem;
    margin: 0;
    color: var(--km-text-muted);
    font-size: 1.08rem;
  }

  /* project cards */

  .projects {
    width: min(760px, 92vw);
    margin: 0 auto;
    padding: 1rem 0 4rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 1.7rem;
    border: 1px solid var(--km-border);
    border-radius: 14px;
    background: var(--km-surface);
    text-decoration: none;
    color: var(--km-text);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 179, 64, 0.4);
    text-decoration: none;
    color: var(--km-text);
  }

  .cardTitle {
    font-family: var(--nb-font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.6rem;
  }

  .desc {
    color: var(--km-text-muted);
    font-size: 0.94rem;
    margin: 0 0 1.4rem;
    flex: 1;
  }

  .link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--km-accent);
  }

  .link i {
    font-style: normal;
    display: inline-block;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card:hover .link i {
    transform: translateX(3px);
  }

  @media (max-width: 860px) {
    .projects {
      grid-template-columns: 1fr;
    }
  }
</style>
