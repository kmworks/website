---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Code } from "../../components/ui/code";
import { Tabs, TabItem } from "../../components/ui/tabs";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import "../../styles/landing.css";

export const prerender = true;

const releasesUrl = "https://github.com/kmworks/kmrs/releases/latest";

const dockerRun = `docker run -d \\
  --name=komga \\
  --user 1000:1000 \\
  -p 25600:25600 \\
  --mount type=bind,source=/path/to/config,target=/config \\
  --mount type=bind,source=/path/to/data,target=/data \\
  --restart unless-stopped \\
  ghcr.io/kmworks/kmrs`;

const binaryRun = `# grab the archive for your platform from the releases page:
#   https://github.com/kmworks/kmrs/releases/latest
./kmrs   # serves on http://localhost:25600`;

const composeRun = `services:
  kmrs:
    image: ghcr.io/kmworks/kmrs:latest
    container_name: kmrs
    user: "1000:1000"
    ports:
      - "25600:25600"
    volumes:
      - ./config:/config
      - ./data:/data
    restart: unless-stopped`;

const diffRun = `python3 tests/diff/diff.py \\
  --java-jar komga.jar \\
  --rust-bin ./kmrs`;

const clients = [
  { label: "KMReader", href: "/reader/", icon: "ph:device-mobile" },
  { label: "KOReader", href: "https://koreader.rocks", icon: "ph:book-open" },
  { label: "Kobo", href: "https://komga.org/docs/guides/kobo", icon: "ph:book-open" },
  { label: "Any Komga client", href: "https://komga.org/docs/category/readers", icon: "ph:arrow-right" },
];
---

<BaseLayout
  title="KMServer — Komga-Compatible Comic & Manga Server, in Rust"
  description="KMServer is a lightweight, Komga-compatible comic and manga server written in Rust, with the web UI included. Same API, same database: point it at your existing Komga library."
>
  <div class="flex flex-col min-h-screen km-landing">
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1">
      {/* Hero */}
      <header class="hero">
        <div class="heroBg"></div>
        <div class="container">
          <div class="heroInner">
            <div>
              <p class="eyebrow">KMServer</p>
              <h1 class="heroTitle">Your library. One server.</h1>
              <p class="heroSub">
                Komga reimplemented in Rust: one static binary, a bounded
                footprint, and the web UI included.
              </p>
              <div class="chipRow" style="margin-top: 0; margin-bottom: 2rem;">
                <span class="chip">Written in Rust</span>
                <span class="chip">Komga-compatible</span>
                <span class="chip">Existing libraries</span>
                <span class="chip">Existing database</span>
                <span class="chip">Cross-platform</span>
                <span class="chip">Single binary</span>
              </div>
              <div class="ctaRow">
                <a class="btnPrimary" href={releasesUrl} target="_blank" rel="noopener">
                  Download KMServer
                </a>
                <a class="btnGhost" href="/server/intro">
                  Documentation <Icon name="ph:arrow-right" class="w-4 h-4" />
                </a>
              </div>
            </div>
            <div class="heroCode">
              <div class="codeCaption">
                <span>terminal</span>
                <span>one command</span>
              </div>
              <Code code={dockerRun} lang="bash" />
            </div>
          </div>
        </div>
      </header>

      {/* Demo */}
      <section class="section">
        <div class="container">
          <div class="sectionCenter" style="margin-bottom: 0;">
            <h2 class="sectionTitle">Try it in your browser.</h2>
            <p class="sectionSub">
              A live KMServer with the bundled web UI and a public-domain
              library of English and Japanese comics and ebooks. Everything
              resets daily.
            </p>
            <div class="demoCreds">
              <div class="demoCred">
                <span class="demoCredLabel">Email</span>
                <code class="demoCredValue">demo@kmworks.date</code>
              </div>
              <div class="demoCred">
                <span class="demoCredLabel">Password</span>
                <code class="demoCredValue">kmworks-demo</code>
              </div>
            </div>
            <a class="btnPrimary" href="https://demo.kmworks.date" target="_blank" rel="noopener" style="margin-top: 2rem;">
              Open the demo <Icon name="ph:arrow-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </section>

      {/* Why KMServer */}
      <section class="section">
        <div class="container">
          <div class="sectionHead">
            <h2 class="sectionTitle">Why KMServer?</h2>
            <p class="sectionSub">
              The Komga experience, rebuilt in Rust: one static binary instead
              of a JVM runtime, and a footprint that stays small.
            </p>
          </div>
          <div class="platformGrid">
            <article class="card">
              <div class="cardIcon">
                <Icon name="ph:code" class="w-[26px] h-[26px]" />
              </div>
              <h3 class="cardTitle">Written in Rust</h3>
              <p class="cardBody">
                A ground-up, memory-safe reimplementation of the Komga server.
                No JVM, no runtime: the whole server ships as one static binary.
              </p>
            </article>
            <article class="card">
              <div class="cardIcon">
                <Icon name="ph:memory" class="w-[26px] h-[26px]" />
              </div>
              <h3 class="cardTitle">Bounded memory</h3>
              <p class="cardBody">
                A 16 MiB SQLite page-cache budget per database and capped
                allocator arenas keep the footprint flat, whatever the
                hardware. <a href="/server/enhancements">Enhancements</a>
              </p>
            </article>
            <article class="card">
              <div class="cardIcon">
                <Icon name="ph:devices" class="w-[26px] h-[26px]" />
              </div>
              <h3 class="cardTitle">Runs anywhere</h3>
              <p class="cardBody">
                Linux, macOS, and Windows, on x86_64 and aarch64. Docker image
                included.
              </p>
            </article>
            <article class="card">
              <div class="cardIcon">
                <Icon name="ph:browser" class="w-[26px] h-[26px]" />
              </div>
              <h3 class="cardTitle">Web UI included</h3>
              <p class="cardBody">
                The Docker image bundles the kmweb UI, so your library works
                in a browser out of the box.
              </p>
            </article>
          </div>
        </div>
      </section>

      {/* Komga compatibility */}
      <section class="section">
        <div class="container">
          <div class="sectionHead">
            <h2 class="sectionTitle">Komga-compatible, verified</h2>
            <p class="sectionSub">
              Same port, same mounts, same environment variables, same API.
            </p>
          </div>
          <div class="cardGrid">
            <div class="card cardWide">
              <div class="cardIcon">
                <Icon name="ph:git-diff" class="w-[26px] h-[26px]" />
              </div>
              <h3 class="cardTitle">API parity, verified</h3>
              <p class="cardBody">
                REST, OPDS v1.2/v2, SSE, Kobo and KOReader sync. A differential
                harness compares about 105 endpoints against a live Java
                instance of the compatibility target (komga 1.28.1).
              </p>
              <Code code={diffRun} lang="bash" />
            </div>
            <div class="card">
              <div class="cardIcon">
                <Icon name="ph:plugs-connected" class="w-[26px] h-[26px]" />
              </div>
              <h3 class="cardTitle">Drop-in replacement</h3>
              <p class="cardBody">
                Same port (25600), same <code>/config</code> and{" "}
                <code>/data</code> mounts, same <code>KOMGA_*</code>{" "}
                environment variables. Your existing setup carries over.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* Existing library / migration */}
      <section class="section">
        <div class="container">
          <div class="split">
            <div>
              <h2 class="sectionTitle">Keep your library. Keep your database.</h2>
              <p class="sectionSub">
                Point KMServer at an existing komga data directory and it
                upgrades <code>database.sqlite</code> in place with
                byte-for-byte Flyway migrations. The Java version can still
                open libraries written by KMServer, so you can switch back at
                any time.
              </p>
              <div class="ctaRow" style="margin-top: 2rem;">
                <a class="btnGhost" href="/server/migration">
                  Migration guide <Icon name="ph:arrow-right" class="w-4 h-4" />
                </a>
              </div>
            </div>
            <div class="statRow" style="margin-top: 0; grid-template-columns: 1fr;">
              <div class="stat">
                <div class="statValue">Same library</div>
                <p class="statLabel">Your files stay where they are.</p>
              </div>
              <div class="stat">
                <div class="statValue">Same database</div>
                <p class="statLabel">Upgraded in place, readable by both servers.</p>
              </div>
              <div class="stat">
                <div class="statValue">Same API</div>
                <p class="statLabel">Your clients reconnect without changes.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Installation */}
      <section class="section">
        <div class="container">
          <div class="split">
            <div>
              <h2 class="sectionTitle">Up and reading in one command</h2>
              <div class="steps">
                <div class="step">
                  <span class="stepName">Install</span>
                  <p class="stepDesc">
                    One <code>docker run</code>, or a single static binary from
                    the releases page.
                  </p>
                </div>
                <div class="step">
                  <span class="stepName">Keep your library</span>
                  <p class="stepDesc">
                    Point <code>/config</code> at your existing komga data.
                    KMServer upgrades it in place.
                  </p>
                </div>
                <div class="step">
                  <span class="stepName">Pick a reader</span>
                  <p class="stepDesc">
                    The bundled web UI, KMReader, KOReader, Kobo, or any OPDS
                    client.
                  </p>
                </div>
              </div>
              <div class="ctaRow" style="margin-top: 2rem;">
                <a class="btnGhost" href="/server/installation">
                  Full installation guide <Icon name="ph:arrow-right" class="w-4 h-4" />
                </a>
              </div>
            </div>
            <div class="codePanel">
              <Tabs>
                <TabItem label="Docker">
                  <Code code={dockerRun} lang="bash" />
                </TabItem>
                <TabItem label="Compose">
                  <Code code={composeRun} lang="yaml" />
                </TabItem>
                <TabItem label="Binary">
                  <Code code={binaryRun} lang="bash" />
                </TabItem>
              </Tabs>
            </div>
          </div>
        </div>
      </section>

      {/* Beyond compatibility */}
      <section class="section">
        <div class="container">
          <div class="sectionHead">
            <h2 class="sectionTitle">Beyond compatibility</h2>
            <p class="sectionSub">
              Capabilities the Java version does not have.
            </p>
          </div>
          <div class="cardGrid">
            <div class="card cardCjk">
              <div class="cardIcon">
                <Icon name="ph:translate" class="w-[26px] h-[26px]" />
              </div>
              <h3 class="cardTitle">CJK cross-search</h3>
              <p class="cardBody">
                Simplified and traditional Chinese match each other, and CJK
                unigrams find titles mid-run. <a href="/server/search">Search</a>
              </p>
              <span class="cjkGlyphs">简繁</span>
            </div>
            <div class="card">
              <div class="cardIcon">
                <Icon name="ph:sort-ascending" class="w-[26px] h-[26px]" />
              </div>
              <h3 class="cardTitle">Natural sort</h3>
              <p class="cardBody">
                Numbered titles order the way you expect: "Page 2" before
                "Page 10", with a configurable ICU locale.
              </p>
            </div>
            <div class="card">
              <div class="cardIcon">
                <Icon name="ph:pulse" class="w-[26px] h-[26px]" />
              </div>
              <h3 class="cardTitle">Heap profiling built in</h3>
              <p class="cardBody">
                jemalloc sampling with a pprof endpoint, always on in release
                builds.
              </p>
            </div>
          </div>
          <div class="chipRow">
            <a class="chip" href="/server/enhancements/webhooks">Webhooks</a>
            <a class="chip" href="/server/enhancements/history-events">History events</a>
            <a class="chip" href="/server/enhancements/epub2-metadata">EPUB 2 metadata</a>
            <a class="chip" href="/server/enhancements/komf">komf integration</a>
            <a class="chip" href="/server/enhancements/thumbnail-storage">File-backed thumbnails</a>
            <a class="chip" href="/server/enhancements/next-previous">Next/previous</a>
            <a class="chip" href="/server/enhancements/reading-stats">Reading stats</a>
            <a class="chip" href="/server/enhancements/smart-lists">Smart lists</a>
            <a class="chip" href="/server/enhancements/server-stats">Server stats</a>
          </div>
          <p class="techNote">
            The full lists live in the docs: <a href="/server/enhancements">Enhancements</a>,{" "}
            <a href="/server/compatibility">Compatibility</a>,{" "}
            <a href="/server/limitations">Known limitations</a>,{" "}
            <a href="/server/development">Development</a>.
          </p>
        </div>
      </section>

      {/* Clients */}
      <section class="section clients">
        <div class="container">
          <h2 class="sectionTitle">Bring your own reader</h2>
          <p class="sectionSub">
            Compatible with the Komga API and its reader ecosystem.
          </p>
          <div class="chipRow">
            {clients.map((c) => (
              <a class="chip" href={c.href}>
                <Icon name={c.icon} class="w-[18px] h-[18px]" />
                {c.label}
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="final">
        <div class="finalBg"></div>
        <div class="container">
          <h2 class="finalTitle">Start serving your comics.</h2>
          <div class="ctaRow">
            <a class="btnPrimary" href={releasesUrl} target="_blank" rel="noopener">
              Download KMServer
            </a>
            <a class="btnGhost" href="/server/intro"> Read the docs </a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  .km-landing .techNote {
    margin: 2.2rem 0 0;
    font-size: 0.88rem;
    color: var(--km-text-muted);
  }

  .km-landing .techNote a,
  .km-landing .cardBody a {
    color: var(--km-accent);
  }
</style>
