{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kmworks",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "kmworks.date", "custom_domain": true },
    { "pattern": "www.kmworks.date", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
